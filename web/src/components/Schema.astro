---
// Structured data, mirroring rataflow's — see that file for the reasoning.
//
// SoftwareApplication here, not SoftwareSourceCode: zoetrope is a program you
// install and run, where rataflow is a library you build against. That choice
// is what `applicationCategory` and `operatingSystem` describe, and it is why
// an `offers` block (free) makes sense on this one and not on the crate.
const SITE = Astro.site?.href.replace(/\/$/, "") ?? "";

const graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "@id": `${SITE}/#software`,
      name: "zoetrope",
      description:
        "A terminal UI that visualizes Claude Code and Codex sessions as live flow graphs. Replay, inspect, or follow a local session.",
      url: SITE,
      applicationCategory: "DeveloperApplication",
      operatingSystem: "macOS, Linux, Windows",
      codeRepository: "https://github.com/furkankly/zoetrope",
      author: { "@id": `${SITE}/#author` },
      image: `${SITE}/og.png`,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    },
    {
      "@type": "Person",
      "@id": `${SITE}/#author`,
      name: "Furkan Kalaycioglu",
      url: "https://furkankly.dev",
    },
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      url: SITE,
      name: "zoetrope",
      publisher: { "@id": `${SITE}/#author` },
    },
  ],
};

const json = JSON.stringify(graph)
  .replace(/</g, "\\u003c")
  .replace(/>/g, "\\u003e")
  .replace(/&/g, "\\u0026");
---

<script type="application/ld+json" is:inline set:html={json} />
